# Healthchecks.io の Ping URL（死活監視・任意）
# 未設定ならハートビートは送信されない
HEALTHCHECK_URL=

# HiyoLove アプリ用サービスアカウント鍵のパス（任意）
# 例: HIYOLOVE_SA_KEY=/home/shinotan/hiyolove-monitor-sa.json
# 未設定なら Firestore への書き出しは丸ごと無効になる
# 鍵ファイルはリポジトリ外に置き chmod 600 にすること
HIYOLOVE_SA_KEY=